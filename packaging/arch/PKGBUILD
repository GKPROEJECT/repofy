pkgname=repofy
pkgver=0.1.1
pkgrel=1
pkgdesc="Software center for Linux"
arch=('x86_64')
url="https://github.com/GKPROEJECT/repofy"
license=('MIT')

depends=(
    'webkit2gtk-4.1'
    'gtk3'
)

makedepends=(
    'git'
    'rust'
    'nodejs'
    'npm'
    'patchelf'
)

source=("git+https://github.com/GKPROEJECT/repofy.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname"

    export CARGO_HOME="$srcdir/cargo"
}

build() {
    cd "$srcdir/$pkgname"

    export RUSTFLAGS="--remap-path-prefix=$srcdir=/usr/src"

    npm ci

    npm run tauri build -- --no-bundle
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm755 \
        "src-tauri/target/release/repofy" \
        "$pkgdir/usr/bin/repofy"

    install -Dm644 \
        "src-tauri/icons/32x32.png" \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/repofy.png"

    install -Dm644 \
        "src-tauri/icons/128x128.png" \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/repofy.png"

    install -Dm644 \
        "src-tauri/icons/128x128@2x.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/repofy.png"

    install -Dm644 \
        "src-tauri/icons/icon.png" \
        "$pkgdir/usr/share/icons/hicolor/512x512/apps/repofy.png"

    install -Dm644 \
        "repofy.desktop" \
        "$pkgdir/usr/share/applications/repofy.desktop"
}
